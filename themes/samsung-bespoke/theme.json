{
  "id": "samsung-bespoke",
  "name": "Samsung Bespoke",
  "version": "1.0.0",
  "description": "Pastel-palette lifestyle theme inspired by Samsung Bespoke home appliances. Softer chrome, larger radii, and warmer neutrals than samsung-kr while staying within the same token tree.",
  "defaultLang": "ko",
  "colors": {
    "brand": {
      "primary": "#2C2A28",
      "primaryHover": "#444140",
      "secondary": "#A88B6E",
      "accent": "#D89C80"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FBF8F5",
      "100": "#F4EFE8",
      "200": "#E8DFD3",
      "300": "#D4C7B5",
      "500": "#8C7E6E",
      "700": "#5C5147",
      "900": "#2C2A28",
      "1000": "#000000"
    },
    "semantic": {
      "success": "#5E8B6B",
      "warning": "#C7894A",
      "danger": "#B65151",
      "info": "#6F86A8"
    },
    "surface": {
      "page": "#FBF8F5",
      "card": "#FFFFFF",
      "elevated": "#F4EFE8",
      "inverse": "#2C2A28"
    },
    "text": {
      "primary": "#2C2A28",
      "secondary": "#5C5147",
      "muted": "#8C7E6E",
      "onBrand": "#FBF8F5",
      "onInverse": "#FBF8F5",
      "onInverseSecondary": "#D4C7B5"
    },
    "border": {
      "subtle": "#E8DFD3",
      "default": "#D4C7B5",
      "strong": "#2C2A28",
      "inverse": "#5C5147"
